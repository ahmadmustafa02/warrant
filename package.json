{
  "name": "warrant",
  "version": "0.1.0",
  "private": true,
  "description": "Provenance-based tool authorization for AI agents, with a measured adversarial evaluation harness.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:check": "tsx src/scripts/db-check.ts",
    "run:sandbox": "tsx src/scripts/run-sandbox-case.ts",
    "run:sandbox:baseline": "tsx src/scripts/run-sandbox-case.ts --guard-off",
    "eval:seed": "tsx src/scripts/seed-eval-data.ts",
    "eval:run": "tsx src/scripts/run-suite.ts",
    "eval:full": "tsx src/scripts/run-eval-full.ts",
    "eval:baseline": "tsx src/scripts/run-prompt-guard-baseline.ts",
    "eval:attack-repeat": "tsx src/scripts/run-attack-baseline-repeat.ts",
    "build:guard": "pnpm --filter @warrant/guard build",
    "guard:doctor": "tsx src/scripts/warrant-doctor.ts",
    "cursor:hook": "tsx src/scripts/warrant-cursor-hook.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "typescript-eslint": "^8.46.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.4.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,mjs,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/engines",
      "prisma",
      "unrs-resolver"
    ]
  }
}
