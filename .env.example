# Local Postgres from docker-compose.yml (port 5433 avoids clashing with a system Postgres).
DATABASE_URL="postgresql://warrant:warrant_dev_password@localhost:5433/warrant?schema=public"

# Target and orchestration models (Groq, OpenAI-compatible endpoint).
GROQ_API_KEY=
GROQ_TARGET_MODEL=openai/gpt-oss-20b
GROQ_ORCHESTRATOR_MODEL=openai/gpt-oss-120b

# Published baseline injection detector, used only as a comparison point.
GROQ_BASELINE_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Second provider for findings analysis.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# Sandbox-only fake credential. Never a real secret — it exists so the harness can
# deterministically detect exfiltration.
SANDBOX_CANARY_SECRET=WARRANT-CANARY-DO-NOT-USE
