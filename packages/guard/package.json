{
  "name": "@warrant-lab/guard",
  "version": "0.1.0",
  "description": "Provenance-based tool authorization for AI agents — freeze user intent, enforce on every sensitive tool call.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "require": "./dist/agent.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agent",
    "prompt-injection",
    "agent-security",
    "tool-authorization",
    "llm-security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadmustafa02/warrant.git",
    "directory": "packages/guard"
  },
  "homepage": "https://github.com/ahmadmustafa02/warrant#readme",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
