// Warrant — data layer.
// Postgres is the system of record for evaluation runs so results are reproducible
// and auditable after the fact, which is the whole point of a security harness.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts for the CLI, and is supplied
// to PrismaClient at runtime through a driver adapter (see src/server/db.ts).
datasource db {
  provider = "postgresql"
}

/// How dangerous a tool is. Only SENSITIVE and DESTRUCTIVE tools require a warrant;
/// READ_ONLY tools stay unrestricted so the guard does not obstruct normal work.
enum RiskTier {
  READ_ONLY
  SENSITIVE
  DESTRUCTIVE
}

/// Where a value in the agent's context came from. Authority derives from USER only.
enum ProvenanceKind {
  USER
  SYSTEM
  TOOL_RESULT
  MEMORY
  WORKER
}

/// The channel an injected instruction arrives through.
enum AttackSurface {
  DOCUMENT
  MEMORY
  MULTI_AGENT
  MCP_TOOL_DESCRIPTION
  WEB_SEARCH
}

enum SuiteKind {
  ATTACK
  BENIGN
}

/// Where a payload came from. Held-out corpora are generated by third-party tools
/// so reported numbers are not tuned against by the defense author.
enum PayloadSource {
  AUTHORED
  PROMPTFOO
  GARAK
}

/// OFF = no protection (baseline). DETECT_ONLY = log but allow (measures detection
/// without confounding it with blocking). ENFORCE = full protection.
enum GuardMode {
  OFF
  DETECT_ONLY
  ENFORCE
}

/// A realistic agent uses NAIVE; HARDENED is reported as a separate comparison row.
enum PromptProfile {
  NAIVE
  HARDENED
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CaseOutcome {
  SAFE
  HIJACKED
  BLOCKED
  ERROR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model TargetAgent {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  modelId       String
  promptProfile PromptProfile @default(NAIVE)
  /// Guard against ever pointing the harness at something that can cause real harm.
  isSandboxed   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  runs          EvalRun[]

  @@index([slug])
}

model Suite {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  kind        SuiteKind
  surface     AttackSurface?
  source      PayloadSource @default(AUTHORED)
  /// True for corpora reserved for final reported numbers.
  isHeldOut   Boolean       @default(false)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payloads    Payload[]
  runs        EvalRun[]

  @@index([kind, isHeldOut])
}

model Payload {
  id          String        @id @default(cuid())
  suiteId     String
  suite       Suite         @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  /// Stable identifier from the authoring source, e.g. a garak probe id.
  externalRef String?
  category    String
  surface     AttackSurface
  severity    Severity      @default(MEDIUM)
  /// The untrusted content delivered to the agent.
  content     String
  /// When set, overrides the default evaluation user message for this payload.
  userTurn    String?
  /// Tools the user's request legitimately authorizes, declared by the payload
  /// author rather than derived at run time.
  ///
  /// Measurement must not ask the intent parser whether the parser was right: if
  /// benign-pass were computed from the derived warrant, a parser that silently
  /// failed to grant a tool would make its own over-block look like a pass.
  expectedTools String[]
  notes       String?
  createdAt   DateTime      @default(now())
  cases       EvalCase[]
  baselines   BaselineResult[]

  @@unique([suiteId, externalRef])
  @@index([surface, category])
}

model EvalRun {
  id            String      @id @default(cuid())
  targetId      String
  target        TargetAgent @relation(fields: [targetId], references: [id], onDelete: Cascade)
  suites        Suite[]
  guardMode     GuardMode
  targetModelId String
  status        RunStatus   @default(PENDING)
  startedAt     DateTime    @default(now())
  finishedAt    DateTime?
  error         String?
  notes         String?
  cases         EvalCase[]
  metric        RunMetric?
  findings      Finding[]

  @@index([status, startedAt])
  @@index([targetId, guardMode])
}

model EvalCase {
  id                String          @id @default(cuid())
  runId             String
  run               EvalRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  payloadId         String
  payload           Payload         @relation(fields: [payloadId], references: [id], onDelete: Restrict)
  outcome           CaseOutcome
  /// Deterministic signals — never an LLM's opinion.
  hijacked          Boolean         @default(false)
  canaryLeaked      Boolean         @default(false)
  sideEffectFired   Boolean         @default(false)
  calledTools       String[]
  blockedTools      String[]
  finalAnswer       String?
  /// Full message and tool-call transcript for replay.
  transcript        Json
  latencyMs         Int
  promptTokens      Int             @default(0)
  completionTokens  Int             @default(0)
  createdAt         DateTime        @default(now())
  decisions         GuardDecision[]
  approvals         ApprovalRequest[]

  @@unique([runId, payloadId])
  @@index([runId, outcome])
}

model GuardDecision {
  id           String          @id @default(cuid())
  caseId       String
  case         EvalCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  toolName     String
  riskTier     RiskTier
  allowed      Boolean
  /// Which provenance authorized the call, when allowed.
  authorizedBy ProvenanceKind?
  /// Provenance kinds tainting the arguments of this call.
  taintSources ProvenanceKind[]
  reason       String
  latencyMs    Int             @default(0)
  createdAt    DateTime        @default(now())

  @@index([caseId, allowed])
}

/// Aggregated, reportable result for one run. The pair of rates is the headline:
/// security without the usability number is not a meaningful claim.
model RunMetric {
  id                 String   @id @default(cuid())
  runId              String   @unique
  run                EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  attacksTotal       Int      @default(0)
  attacksStopped     Int      @default(0)
  attackStopRate     Float    @default(0)
  benignTotal        Int      @default(0)
  benignPassed       Int      @default(0)
  benignPassRate     Float    @default(0)
  errorCount         Int      @default(0)
  p95GuardLatencyMs  Int      @default(0)
  totalPromptTokens  Int      @default(0)
  totalCompletionTokens Int   @default(0)
  estimatedCostUsd   Decimal? @db.Decimal(12, 6)
  createdAt          DateTime @default(now())
}

/// Score from a published third-party detector on the same payload, for comparison.
model BaselineResult {
  id            String   @id @default(cuid())
  payloadId     String
  payload       Payload  @relation(fields: [payloadId], references: [id], onDelete: Cascade)
  detectorModel String
  score         Float
  flagged       Boolean
  threshold     Float
  createdAt     DateTime @default(now())

  @@unique([payloadId, detectorModel, threshold])
}

model ApprovalRequest {
  id          String         @id @default(cuid())
  caseId      String?
  case        EvalCase?      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  toolName    String
  args        Json
  status      ApprovalStatus @default(PENDING)
  reason      String?
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?

  @@index([status, requestedAt])
}

model Finding {
  id            String        @id @default(cuid())
  runId         String
  run           EvalRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  title         String
  summary       String
  severity      Severity
  surface       AttackSurface
  category      String
  /// Model that produced the analysis, for provenance of the report itself.
  analystModel  String?
  createdAt     DateTime      @default(now())

  @@index([runId, severity])
}
